# Frontend/server (same origin). Both flags required; default false.
VITE_ADC_AUTH_ENABLED=false
ADC_AUTH_ENABLED=false
ADC_APP_ORIGIN=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=
CONVEX_DEPLOYMENT=
# Convex environment only (not VITE_*, do not commit)
BETTER_AUTH_SECRET=
SITE_URL=
RESEND_API_KEY=
MAIL_FROM=
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# TanStack server: enable only in isolated staging after auth verification
ADC_PORTAL_ENABLED=false
# Convex environment only: never enable in production
ADC_STAGING_CMS=false
# Convex environment: independent portal kill switch, enable only in isolated staging
ADC_CONVEX_PORTAL_ENABLED=false

# BOTH TanStack server and Convex: staging only, never production
ADC_STAGING_ADMIN_UI=false

# Documents: server and Convex independent kill switches, staging only until scan pipeline validated
ADC_DOCUMENTS_ENABLED=false
ADC_CONVEX_DOCUMENTS_ENABLED=false
# SAME random 32+ character secret in server + Convex env (never VITE_)
ADC_DOCUMENT_DELIVERY_SECRET=

# Financial projections: independent read kill switches, default off
ADC_FINANCE_ENABLED=false
ADC_CONVEX_FINANCE_ENABLED=false

# Staging PDF upload: independent flags; separate write-only scoped R2 credentials.
ADC_UPLOAD_ENABLED=false
ADC_CONVEX_UPLOAD_ENABLED=false
ADC_DOCUMENT_UPLOAD_SECRET=
R2_UPLOAD_ACCESS_KEY_ID=
R2_UPLOAD_SECRET_ACCESS_KEY=

# Q&A independently gated; default off
ADC_QA_ENABLED=false
ADC_CONVEX_QA_ENABLED=false

ADC_ANALYTICS_ENABLED=false
ADC_CONVEX_ANALYTICS_ENABLED=false

# Server only: GitHub reporting, read-only fine-grained credential; map exact room IDs to repository targets.
ADC_GITHUB_REPORTING_ENABLED=false
ADC_GITHUB_READ_TOKEN=
ADC_GITHUB_TARGETS={}
